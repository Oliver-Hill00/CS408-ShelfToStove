[Unit]
Description=ShelfToStove Node.js app
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/shelftostove
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/shelftostove/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
